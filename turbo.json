{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "TURSO_DATABASE_URL",
    "TURSO_AUTH_TOKEN",
    "ARKIV_PRIVATE_KEY",
    "ARKIV_RPC_URL",
    "SWARM_BEE_URL",
    "SWARM_ACT_PUBLISHER_KEY"
  ],
  "globalPassThroughEnv": [
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
    "NEXT_PUBLIC_NECTAR_SUBSCRIPTIONS_ADDRESS",
    "NEXT_PUBLIC_FUJI_RPC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {}
  }
}
