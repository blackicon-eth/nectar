# ── Turso (operational state / cache) ──────────────────────────────
TURSO_DATABASE_URL=libsql://nectar-yourname.turso.io
TURSO_AUTH_TOKEN=

# ── Arkiv (queryable metadata index, Tiramisu testnet) ─────────────
# Relayer/signing key for entity writes. Keep server-side only.
ARKIV_PRIVATE_KEY=
# Optional: override the default Tiramisu RPC (public endpoint is rate-limited).
ARKIV_RPC_URL=
# Article entity lifetime in days (Arkiv expires entities by block height).
ARKIV_ARTICLE_TTL_DAYS=90

# ── Swarm (canonical content storage) ──────────────────────────────
# Bee node HTTP API. Default: local Bee node.
SWARM_BEE_URL=http://localhost:1633
# Postage batch id (buy with xBZZ, or use a Swarm gift code during the event).
SWARM_POSTAGE_BATCH_ID=
# Optional debug API url if you run a local node with debug enabled.
SWARM_BEE_DEBUG_URL=http://localhost:1635
