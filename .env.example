# ── Turso (operational state / cache) ──────────────────────────────
TURSO_DATABASE_URL=libsql://nectar-yourname.turso.io
TURSO_AUTH_TOKEN=

# ── Arkiv (queryable metadata index, Tiramisu testnet) ─────────────
# Wallet private key (hex) used to sign entity writes. Fund it with test GLM
# from https://hub.arkiv.network/faucet (native gas token is GLM).
ARKIV_PRIVATE_KEY=
# Optional: override the default Tiramisu RPC (public endpoint is rate-limited).
ARKIV_RPC_URL=
# ── Swarm (canonical content storage) ──────────────────────────────
# Public gateway. Uploads are auto-stamped (no postage batch required).
SWARM_BEE_URL=https://api.gateway.ethswarm.org
# ACT publisher private key (32-byte hex). The Swarm ID account "sharing key",
# used server-side to publish and decrypt premium (ACT) content.
SWARM_ACT_PUBLISHER_KEY=

# ── Avalanche Fuji / Subscriptions (payments) ──────────────────────
# RPC endpoint for Avalanche Fuji C-Chain (chain id 43113).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Deployer/owner private key used to deploy NectarSubscriptions.
DEPLOYER_PRIVATE_KEY=
# Nectar treasury address that receives the 10% platform share.
TREASURY_ADDRESS=
# Payment stablecoin. Defaults to Circle's official Fuji testnet USDC (6 decimals).
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Deployed NectarSubscriptions registry address (exposed to the browser).
NEXT_PUBLIC_NECTAR_SUBSCRIPTIONS_ADDRESS=
